---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const latest = allArticles
  .sort((a, b) => {
    const dA = a.data.published_at ?? a.data.written_at;
    const dB = b.data.published_at ?? b.data.written_at;
    return dB.getTime() - dA.getTime();
  })
  .slice(0, 6);

const featured = allArticles.find((a) => a.data.featured) ?? latest[0];

// Search index passed to client — compact keys to minimize payload
const searchIndex = allArticles.map(a => ({
  t: a.data.title,
  d: a.data.description,
  c: a.data.category,
  p: a.data.pillar ?? '',
  u: `/${a.data.category}/${a.id}/`,
  q: a.data.top_search_queries ?? [],
}));
---

<Layout
  title="DonanimKlinik — Diagnose it. Fix it."
  description="Step-by-step fixes for the tech problems that stop you cold — BitLocker lockouts, dead Wi-Fi drivers, BSOD codes, and router settings nobody explains properly. Sourced from official documentation, verified by hand."
  canonical="https://www.donanimklinik.com/"
>

<!-- Hero -->
<section class="hero">
  <div class="hero-scanline" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-content">
      <div class="hero-badge" aria-label="We diagnose and fix tech errors">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        <span class="hero-badge-cycle" aria-hidden="true">
          <span>BitLocker locked</span>
          <span>BSOD 0x0000007B</span>
          <span>Wi-Fi driver fail</span>
          <span>Outlook not syncing</span>
          <span>USB not recognized</span>
        </span>
        <svg class="hero-badge-arrow" width="13" height="9" viewBox="0 0 13 9" fill="none" aria-hidden="true">
          <path d="M1 4.5h11M7.5 1L11.5 4.5 7.5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="hero-badge-fix">FIXED</span>
      </div>
      <h1 class="display">
        <span class="hero-line-a">Every error code</span>
        <span class="hero-line-b hero-word-grad">Has an official fix</span>
      </h1>
      <p class="hero-sub">We trace every guide to the manufacturer's own documentation.<br>Not forums. Not guesses. The right answer, every time.</p>
      <div class="lookup-wrap">
        <div class="lookup-header mono">
          <svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <circle cx="5.5" cy="5.5" r="4.5" stroke="var(--amber)" stroke-width="1.6"/>
            <path d="M9 9L12 12" stroke="var(--amber)" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span>error_lookup.exe</span>
          <span class="lookup-header-hint">press Enter to search</span>
        </div>
        <div class="lookup" role="search">
          <input type="text" id="error-lookup" class="mono" placeholder="0x0000007B, 0xC004F050, paper jam..." aria-label="Search error code or keyword" autocomplete="off" spellcheck="false">
          <button type="button" id="search-run-btn">Run</button>
        </div>
        <div class="search-drop" id="search-drop" role="listbox" aria-label="Search results" hidden>
          <div class="search-drop-list" id="search-drop-list"></div>
          <div class="search-drop-hint">
            <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
            <span><kbd>↵</kbd> open</span>
            <span><kbd>Esc</kbd> close</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- Categories -->
<section class="categories" aria-labelledby="cat-heading">
  <div class="wrap">
    <div class="section-label" id="cat-heading">Browse by category</div>
    <div class="cat-grid">

      <a href="/computers" class="cat red">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="4" width="19" height="13" rx="1.5" stroke="var(--red)" stroke-width="1.6"/>
            <path d="M8.5 20.5h7M12 17v3.5" stroke="var(--red)" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="cat-code mono">01 · COMPUTERS</div>
        <h3>Computers</h3>
        <p>BSOD codes, boot loops, dead drives, data recovery.</p>
      </a>

      <a href="/networking" class="cat blue">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 9.5c4.5-4 11.5-4 16 0M7 13c2.8-2.3 7.2-2.3 10 0M10 16.5c1.2-1 2.8-1 4 0" stroke="var(--brand-blue)" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="12" cy="19.5" r="1.2" fill="var(--brand-blue)"/>
          </svg>
        </div>
        <div class="cat-code mono">02 · NETWORKING</div>
        <h3>Networking</h3>
        <p>Wi-Fi, routers, VPN conflicts, NAS devices, email auth errors.</p>
      </a>

      <a href="/software" class="cat trace">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="4" width="19" height="16" rx="1.5" stroke="var(--trace)" stroke-width="1.6"/>
            <path d="M2.5 8h19" stroke="var(--trace)" stroke-width="1.6"/>
          </svg>
        </div>
        <div class="cat-code mono">03 · SOFTWARE</div>
        <h3>Software & Apps</h3>
        <p>Office errors, activation codes, sync failures.</p>
      </a>

      <a href="/peripherals" class="cat amber">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 12a8 8 0 0 1 16 0" stroke="var(--amber)" stroke-width="1.6"/>
            <rect x="2.5" y="12" width="4" height="6" rx="1.2" stroke="var(--amber)" stroke-width="1.6"/>
            <rect x="17.5" y="12" width="4" height="6" rx="1.2" stroke="var(--amber)" stroke-width="1.6"/>
          </svg>
        </div>
        <div class="cat-code mono">04 · PERIPHERALS</div>
        <h3>Peripherals</h3>
        <p>USB drives, external storage errors, display adapters.</p>
      </a>

    </div>
  </div>
</section>

<!-- Featured -->
{featured && (
  <section class="featured" aria-labelledby="feat-heading">
    <div class="wrap">
      <div class="section-label" id="feat-heading" style="color: var(--red);">Diagnosis of the week</div>
      <div class="feat-card">
        <div class="feat-left">
          <div class="feat-eyebrow mono">
            {featured.data.category.charAt(0).toUpperCase() + featured.data.category.slice(1)} · Verified against official docs
          </div>
          <h2 class="display">{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <a href={`/${featured.data.category}/${featured.id}/`} class="feat-cta">
            Read the diagnosis →
          </a>
        </div>
        <div class="feat-right">
          <p class="mono" style="font-size:12px; color: var(--text-faint); line-height:1.7;">
            Every step in this guide traces back to the official manufacturer or software
            documentation — no guesswork, no forum rumours.
          </p>
          <a
            href={featured.data.official_source_url}
            target="_blank"
            rel="noopener noreferrer"
            class="article-source-link"
          >
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Official source
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<!-- Latest Articles -->
{latest.length > 0 && (
  <section class="articles" aria-labelledby="latest-heading">
    <div class="wrap">
      <div class="section-label" id="latest-heading">Latest diagnoses</div>
      <div class="art-grid">
        {latest.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            category={article.data.category}
            slug={article.id}
            readTime={article.data.read_time}
            publishedAt={article.data.published_at ?? article.data.written_at}
          />
        ))}
      </div>
    </div>
  </section>
)}

{latest.length === 0 && (
  <section class="articles">
    <div class="wrap">
      <div class="section-label">Latest diagnoses</div>
      <div class="empty-state">
        <p class="mono" style="font-size:13px; color:var(--text-faint);">&gt; No articles published yet.</p>
        <p>Check back soon — guides are in review.</p>
      </div>
    </div>
  </section>
)}

<script>
  // Staggered scroll-reveal for article cards
  const grid = document.querySelector('.art-grid');
  if (grid) {
    grid.classList.add('js-reveal');
    const cards = [...grid.querySelectorAll('.art-card')];
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const idx = cards.indexOf(entry.target as HTMLElement);
          setTimeout(() => entry.target.classList.add('is-visible'), idx * 80);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    cards.forEach(card => obs.observe(card));
  }
</script>

<script define:vars={{ searchIndex }}>
(function () {
  const input = document.getElementById('error-lookup');
  const btn = document.getElementById('search-run-btn');
  const drop = document.getElementById('search-drop');
  const list = document.getElementById('search-drop-list');
  if (!input || !btn || !drop || !list) return;

  const CAT_COLORS = {
    computers: '#F0553A',
    networking: '#2BB3E0',
    software: '#79F0C0',
    peripherals: '#FBB03B',
  };

  // --- Scoring ---
  function scoreItem(item, terms, phrase) {
    const tL = item.t.toLowerCase();
    const dL = item.d.toLowerCase();
    const qL = item.q.join(' ').toLowerCase();
    const pL = item.p.toLowerCase();
    let pts = 0;

    if (tL === phrase)              pts += 20;
    else if (tL.startsWith(phrase)) pts += 14;
    else if (tL.includes(phrase))   pts += 11;

    if (qL.includes(phrase))        pts += 8;
    if (pL.includes(phrase))        pts += 5;
    if (dL.includes(phrase))        pts += 3;

    for (const term of terms) {
      if (tL.includes(term)) pts += 4;
      if (qL.includes(term)) pts += 3;
      if (pL.includes(term)) pts += 2;
      if (dL.includes(term)) pts += 1;
    }
    return pts;
  }

  function runSearch(raw) {
    const terms = raw.toLowerCase().trim().split(/\s+/).filter(Boolean);
    if (!terms.length) return [];
    const phrase = terms.join(' ');
    return searchIndex
      .map(item => ({ item, pts: scoreItem(item, terms, phrase) }))
      .filter(x => x.pts > 0)
      .sort((a, b) => b.pts - a.pts)
      .slice(0, 7)
      .map(x => x.item);
  }

  // --- Safe HTML helpers ---
  function esc(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function escRe(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }
  function highlight(text, terms) {
    let out = esc(text);
    for (const term of terms) {
      const safe = escRe(esc(term));
      out = out.replace(new RegExp('(' + safe + ')', 'gi'), '<mark>$1</mark>');
    }
    return out;
  }

  // --- Render ---
  function render(results, terms) {
    if (!results.length) {
      const gUrl = 'https://www.google.com/search?q=' + encodeURIComponent(terms.join(' ') + ' site:donanimklinik.com');
      list.innerHTML = `<div class="search-drop-empty">No match — <a href="${gUrl}" target="_blank" rel="noopener noreferrer">search Google</a></div>`;
    } else {
      list.innerHTML = results.map((item, i) => {
        const color = CAT_COLORS[item.c] || '#aaa';
        const desc = item.d.length > 100 ? item.d.slice(0, 97) + '…' : item.d;
        return `<a class="search-drop-item" href="${esc(item.u)}" role="option" tabindex="-1" data-idx="${i}">
          <span class="search-drop-cat" style="color:${color}">${esc(item.c)}</span>
          <span class="search-drop-title">${highlight(item.t, terms)}</span>
          <svg class="search-drop-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="search-drop-desc">${highlight(desc, terms)}</span>
        </a>`;
      }).join('');
    }
    drop.hidden = false;
    activeIdx = -1;
  }

  function close() {
    drop.hidden = true;
    activeIdx = -1;
  }

  function open(raw) {
    const q = raw.trim();
    if (!q) { close(); return; }
    const results = runSearch(q);
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    render(results, terms);
  }

  // --- Keyboard navigation ---
  let activeIdx = -1;

  function getItems() {
    return [...list.querySelectorAll('.search-drop-item')];
  }

  function setActive(idx) {
    const items = getItems();
    if (!items.length) return;
    idx = Math.max(0, Math.min(idx, items.length - 1));
    items.forEach((el, i) => el.classList.toggle('is-active', i === idx));
    activeIdx = idx;
    items[idx].focus();
  }

  input.addEventListener('input', () => open(input.value));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { close(); return; }
    if (drop.hidden) {
      if (e.key === 'Enter') { e.preventDefault(); open(input.value); return; }
      return;
    }
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(0); return; }
    if (e.key === 'Enter') {
      e.preventDefault();
      const first = list.querySelector('.search-drop-item');
      if (first) first.click();
    }
  });

  list.addEventListener('keydown', (e) => {
    const items = getItems();
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); }
    else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (activeIdx <= 0) { input.focus(); activeIdx = -1; items.forEach(el => el.classList.remove('is-active')); }
      else setActive(activeIdx - 1);
    }
    else if (e.key === 'Escape') { close(); input.focus(); }
    else if (e.key === 'Enter' && activeIdx >= 0 && items[activeIdx]) {
      items[activeIdx].click();
    }
  });

  btn.addEventListener('click', () => {
    if (!drop.hidden) {
      const first = list.querySelector('.search-drop-item');
      if (first) { first.click(); return; }
    }
    open(input.value);
    input.focus();
  });

  // Close when focus leaves the lookup-wrap
  document.addEventListener('focusin', (e) => {
    const wrap = document.querySelector('.lookup-wrap');
    if (wrap && !wrap.contains(e.target)) close();
  });

  document.addEventListener('click', (e) => {
    const wrap = document.querySelector('.lookup-wrap');
    if (wrap && !wrap.contains(e.target)) close();
  });
})();
</script>

</Layout>
