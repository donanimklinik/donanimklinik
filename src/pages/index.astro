---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const latest = allArticles
  .sort((a, b) => {
    const dA = a.data.published_at ?? a.data.written_at;
    const dB = b.data.published_at ?? b.data.written_at;
    return dB.getTime() - dA.getTime();
  })
  .slice(0, 6);

const featured = allArticles.find((a) => a.data.featured) ?? latest[0];
---

<Layout
  title="DonanimKlinik — Diagnose it. Fix it."
  description="Step-by-step fixes for the tech problems that stop you cold — BitLocker lockouts, dead Wi-Fi drivers, BSOD codes, and router settings nobody explains properly. Sourced from official documentation, verified by hand."
  canonical="https://www.donanimklinik.com/"
>

<!-- Hero -->
<section class="hero">
  <!-- Background: grid + scan beam + floating error codes -->
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-scan" aria-hidden="true"></div>
  <span class="hero-code" style="left:4%;  --d:0s"  aria-hidden="true">0xC004F050</span>
  <span class="hero-code" style="left:18%; --d:6s"  aria-hidden="true">KERNEL_PANIC</span>
  <span class="hero-code" style="left:72%; --d:3s"  aria-hidden="true">0x8007232B</span>
  <span class="hero-code" style="left:84%; --d:9s"  aria-hidden="true">0x800CCC0E</span>
  <span class="hero-code" style="left:55%; --d:14s" aria-hidden="true">IMAP_CONN_FAIL</span>
  <span class="hero-code" style="left:38%; --d:18s" aria-hidden="true">0xC004C008</span>
  <span class="hero-code" style="left:91%; --d:4s"  aria-hidden="true">WIN_ACTIVATION</span>
  <span class="hero-code" style="left:27%; --d:11s" aria-hidden="true">0x80042108</span>
  <div class="wrap">
    <div class="hero-content">
      <p class="hero-label mono">donanimklinik — diagnostic engine</p>
      <h1 class="display">
        <span class="hero-word-grad">Diagnose</span> the exact<br>fault. Fix it once<span class="cursor">_</span>
      </h1>
      <p class="hero-sub">Official manufacturer docs only — exact error code, exact fix.</p>
      <div class="lookup-wrap">
        <div class="lookup-header mono">
          <svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <circle cx="5.5" cy="5.5" r="4.5" stroke="var(--amber)" stroke-width="1.6"/>
            <path d="M9 9L12 12" stroke="var(--amber)" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span>error_lookup.exe</span>
          <span class="lookup-header-hint">press Enter to search</span>
        </div>
        <div class="lookup" role="search">
          <input type="text" id="error-lookup" class="mono" placeholder="0x0000007B, 0xC004F050, SMTP_CONN..." aria-label="Search error code">
          <button type="button">Run</button>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- Categories -->
<section class="categories" aria-labelledby="cat-heading">
  <div class="wrap">
    <div class="section-label" id="cat-heading">Browse by category</div>
    <div class="cat-grid">

      <a href="/computers" class="cat red">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="4" width="19" height="13" rx="1.5" stroke="var(--red)" stroke-width="1.6"/>
            <path d="M8.5 20.5h7M12 17v3.5" stroke="var(--red)" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="cat-code mono">01 · COMPUTERS</div>
        <h3>Computers</h3>
        <p>BSOD codes, boot loops, dead drives, data recovery.</p>
      </a>

      <a href="/networking" class="cat blue">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 9.5c4.5-4 11.5-4 16 0M7 13c2.8-2.3 7.2-2.3 10 0M10 16.5c1.2-1 2.8-1 4 0" stroke="var(--brand-blue)" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="12" cy="19.5" r="1.2" fill="var(--brand-blue)"/>
          </svg>
        </div>
        <div class="cat-code mono">02 · NETWORKING</div>
        <h3>Networking</h3>
        <p>Wi-Fi, routers, VPN conflicts, NAS devices, email auth errors.</p>
      </a>

      <a href="/software" class="cat trace">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="4" width="19" height="16" rx="1.5" stroke="var(--trace)" stroke-width="1.6"/>
            <path d="M2.5 8h19" stroke="var(--trace)" stroke-width="1.6"/>
          </svg>
        </div>
        <div class="cat-code mono">03 · SOFTWARE</div>
        <h3>Software & Apps</h3>
        <p>Office errors, activation codes, sync failures.</p>
      </a>

      <a href="/peripherals" class="cat amber">
        <div class="cat-icon-ring">
          <svg class="cat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 12a8 8 0 0 1 16 0" stroke="var(--amber)" stroke-width="1.6"/>
            <rect x="2.5" y="12" width="4" height="6" rx="1.2" stroke="var(--amber)" stroke-width="1.6"/>
            <rect x="17.5" y="12" width="4" height="6" rx="1.2" stroke="var(--amber)" stroke-width="1.6"/>
          </svg>
        </div>
        <div class="cat-code mono">04 · PERIPHERALS</div>
        <h3>Peripherals</h3>
        <p>USB drives, external storage errors, display adapters.</p>
      </a>

    </div>
  </div>
</section>

<!-- Featured -->
{featured && (
  <section class="featured" aria-labelledby="feat-heading">
    <div class="wrap">
      <div class="section-label" id="feat-heading" style="color: var(--red);">Diagnosis of the week</div>
      <div class="feat-card">
        <div class="feat-left">
          <div class="feat-eyebrow mono">
            {featured.data.category.charAt(0).toUpperCase() + featured.data.category.slice(1)} · Verified against official docs
          </div>
          <h2 class="display">{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <a href={`/${featured.data.category}/${featured.id}/`} class="feat-cta">
            Read the diagnosis →
          </a>
        </div>
        <div class="feat-right">
          <p class="mono" style="font-size:12px; color: var(--text-faint); line-height:1.7;">
            Every step in this guide traces back to the official manufacturer or software
            documentation — no guesswork, no forum rumours.
          </p>
          <a
            href={featured.data.official_source_url}
            target="_blank"
            rel="noopener noreferrer"
            class="article-source-link"
          >
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Official source
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<!-- Latest Articles -->
{latest.length > 0 && (
  <section class="articles" aria-labelledby="latest-heading">
    <div class="wrap">
      <div class="section-label" id="latest-heading">Latest diagnoses</div>
      <div class="art-grid">
        {latest.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            category={article.data.category}
            slug={article.id}
            readTime={article.data.read_time}
            publishedAt={article.data.published_at ?? article.data.written_at}
          />
        ))}
      </div>
    </div>
  </section>
)}

{latest.length === 0 && (
  <section class="articles">
    <div class="wrap">
      <div class="section-label">Latest diagnoses</div>
      <div class="empty-state">
        <p class="mono" style="font-size:13px; color:var(--text-faint);">&gt; No articles published yet.</p>
        <p>Check back soon — guides are in review.</p>
      </div>
    </div>
  </section>
)}

<script>
  // Staggered scroll-reveal for article cards
  const grid = document.querySelector('.art-grid');
  if (grid) {
    grid.classList.add('js-reveal');
    const cards = [...grid.querySelectorAll('.art-card')];
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const idx = cards.indexOf(entry.target as HTMLElement);
          setTimeout(() => entry.target.classList.add('is-visible'), idx * 80);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    cards.forEach(card => obs.observe(card));
  }
</script>

</Layout>
