---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles.map((article) => ({
    params: {
      category: article.data.category,
      slug: article.id,
    },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const { Content } = await render(article);

const relatedArticles = allArticles
  .filter((a) => a.data.pillar === article.data.pillar && a.id !== article.id)
  .slice(0, 3)
  .map((a) => ({
    id: a.id,
    title: a.data.title,
    description: a.data.description,
    category: a.data.category,
    readTime: a.data.read_time,
  }));
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  category={article.data.category}
  slug={article.id}
  officialSourceUrl={article.data.official_source_url}
  writtenAt={article.data.written_at}
  publishedAt={article.data.published_at}
  readTime={article.data.read_time}
  schemaType={article.data.schema_type}
  howtoSteps={article.data.howto_steps}
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
