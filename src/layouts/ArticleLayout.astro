---
import Layout from './Layout.astro';
import AdUnit from '../components/AdUnit.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  officialSourceUrl: string;
  writtenAt: Date;
  publishedAt?: Date;
  readTime?: number;
  schemaType?: 'Article' | 'HowTo' | 'FAQPage';
  howtoSteps?: { name: string; text: string }[];
  relatedArticles?: { id: string; title: string; description: string; category: string; readTime?: number }[];
  pillarName?: string;
  pillarSlug?: string;
}

const {
  title,
  description,
  category,
  slug,
  officialSourceUrl,
  writtenAt,
  publishedAt,
  readTime,
  schemaType = 'Article',
  howtoSteps,
  relatedArticles = [],
  pillarName,
  pillarSlug,
} = Astro.props;

const canonical = `https://www.donanimklinik.com/${category}/${slug}/`;
const pubDate = publishedAt ?? writtenAt;

const tagMap: Record<string, { label: string; cls: string; color: string }> = {
  computers:   { label: 'Computers',   cls: 'red',    color: 'var(--red)' },
  phones:      { label: 'Phones',      cls: 'violet', color: 'var(--violet)' },
  networking:  { label: 'Networking',  cls: 'blue',   color: 'var(--brand-blue)' },
  software:    { label: 'Software',    cls: 'trace',  color: 'var(--trace)' },
  peripherals: { label: 'Peripherals', cls: 'amber',  color: 'var(--amber)' },
};
const tag = tagMap[category] ?? { label: category, cls: 'trace', color: 'var(--trace)' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: title,
  description,
  url: canonical,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'DonanimKlinik',
    url: 'https://www.donanimklinik.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'DonanimKlinik',
    url: 'https://www.donanimklinik.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  ...(schemaType === 'Article' && {
    articleSection: tag.label,
    isBasedOn: officialSourceUrl,
  }),
  ...(schemaType === 'HowTo' && howtoSteps && {
    step: howtoSteps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.donanimklinik.com/' },
    { '@type': 'ListItem', position: 2, name: tag.label, item: `https://www.donanimklinik.com/${category}/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};

const dateStr = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(pubDate);

const sourceUrl = new URL(officialSourceUrl);
const sourceDomain = sourceUrl.hostname.replace('www.', '');
---

<Layout
  title={`${title} | DonanimKlinik`}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  catClass={`cat-${category}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="article-page-hero">
    <div class="article-page-glow" style={`background: ${tag.color};`} aria-hidden="true"></div>
    <div class="wrap">
      <!-- Breadcrumb -->
      <nav class="page-breadcrumb" style="padding-top: 28px;" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href={`/${category}/`}>{tag.label}</a>
        {pillarName && pillarSlug && (
          <>
            <span aria-hidden="true">›</span>
            <a href={`/${category}/${pillarSlug}/`}>{pillarName}</a>
          </>
        )}
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <!-- Article meta header -->
      <div class="article-meta-header">
        <span class={`art-tag ${tag.cls}`}>{tag.label}</span>
        <h1>{title}</h1>
        <div class="article-meta-row">
          <span>{dateStr}</span>
          {readTime && <span>{readTime} min read</span>}
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <!-- Ad: above article -->
    <AdUnit />

    <!-- Article content -->
    <article class="article-body">
      <slot />
    </article>

    <!-- Ad: below article -->
    <AdUnit />

    <!-- Related articles -->
    {relatedArticles.length > 0 && <RelatedArticles articles={relatedArticles} />}

    <!-- Source citation -->
    <aside class="source-section">
      <h2 class="source-section-title mono">Source</h2>
      <a class="source-card" href={officialSourceUrl} target="_blank" rel="noopener noreferrer">
        <svg class="source-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="12" cy="16" r="1.5" fill="currentColor"/>
        </svg>
        <div class="source-card-body">
          <span class="source-card-domain">{sourceDomain}</span>
          <span class="source-card-caption">Official documentation</span>
        </div>
        <svg class="source-card-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </aside>

  </div>
</Layout>

<!-- Lightbox -->
<div id="lb-overlay" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
  <button id="lb-close" aria-label="Close image">&times;</button>
  <img id="lb-img" src="" alt="">
</div>

<style>
  /* ── Article images ── */
  .article-body img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #1e3a22;
    margin: 2rem auto;
    cursor: zoom-in;
    transition: opacity .15s, border-color .15s;
  }
  .article-body img:hover {
    opacity: .88;
    border-color: #00E5A0;
  }

  /* ── Lightbox overlay ── */
  #lb-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: lb-in .15s ease;
  }
  #lb-overlay[hidden] { display: none; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }

  #lb-img {
    max-width: min(96vw, 1100px);
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: 10px;
    border: 1px solid #2d5a3d;
    box-shadow: 0 0 80px rgba(0,229,160,.08);
    cursor: default;
  }

  #lb-close {
    position: fixed;
    top: 1.2rem;
    right: 1.5rem;
    background: none;
    border: 1px solid #2d5a3d;
    color: #F0F4F1;
    font-size: 1.8rem;
    line-height: 1;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .15s, color .15s;
  }
  #lb-close:hover { border-color: #00E5A0; color: #00E5A0; }
</style>

<script>
  const overlay = document.getElementById('lb-overlay') as HTMLElement;
  const lbImg   = document.getElementById('lb-img')     as HTMLImageElement;
  const lbClose = document.getElementById('lb-close')   as HTMLButtonElement;

  function openLightbox(src: string, alt: string) {
    lbImg.src = src;
    lbImg.alt = alt;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }
  function closeLightbox() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    lbImg.src = '';
  }

  // Click any article image
  document.querySelectorAll('.article-body img').forEach(img => {
    const el = img as HTMLImageElement;
    el.setAttribute('title', 'Click to enlarge');
    el.addEventListener('click', () => openLightbox(el.src, el.alt));
  });

  lbClose.addEventListener('click', closeLightbox);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeLightbox(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
