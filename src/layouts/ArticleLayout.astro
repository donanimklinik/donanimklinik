---
import Layout from './Layout.astro';
import AdUnit from '../components/AdUnit.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import AnswerCard from '../components/AnswerCard.astro';
import RelatedChips from '../components/RelatedChips.astro';
import HubPill from '../components/HubPill.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  officialSourceUrl: string;
  writtenAt: Date;
  publishedAt?: Date;
  updatedAt?: Date;
  readTime?: number;
  schemaType?: 'Article' | 'HowTo' | 'FAQPage';
  howtoSteps?: { name: string; text: string }[];
  relatedArticles?: { id: string; title: string; description: string; category: string; readTime?: number }[];
  faq?: { q: string; a: string }[];
  pillarName?: string;
  pillarSlug?: string;
  fixSummary?: string;
  fixTime?: string;
  fixDifficulty?: 'Easy' | 'Medium' | 'Hard';
}

const {
  title,
  description,
  category,
  slug,
  officialSourceUrl,
  writtenAt,
  publishedAt,
  updatedAt,
  readTime,
  schemaType = 'Article',
  howtoSteps,
  relatedArticles = [],
  faq,
  pillarName,
  pillarSlug,
  fixSummary,
  fixTime,
  fixDifficulty,
} = Astro.props;

const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;

const canonical = `https://www.donanimklinik.com/${category}/${slug}/`;
const pubDate = publishedAt ?? writtenAt;
const modDate = updatedAt ?? pubDate;

const tagMap: Record<string, { label: string; cls: string; color: string }> = {
  computers:   { label: 'Computers',   cls: 'red',    color: 'var(--red)' },
  phones:      { label: 'Phones',      cls: 'violet', color: 'var(--violet)' },
  networking:  { label: 'Networking',  cls: 'blue',   color: 'var(--brand-blue)' },
  software:    { label: 'Software',    cls: 'trace',  color: 'var(--trace)' },
  peripherals: { label: 'Peripherals', cls: 'amber',  color: 'var(--amber)' },
};
const tag = tagMap[category] ?? { label: category, cls: 'trace', color: 'var(--trace)' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  headline: title,
  description,
  image: {
    '@type': 'ImageObject',
    url: `https://www.donanimklinik.com/images/${slug}.svg`,
    width: 800,
    height: 420,
  },
  url: canonical,
  datePublished: pubDate.toISOString(),
  dateModified: modDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'DonanimKlinik',
    url: 'https://www.donanimklinik.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'DonanimKlinik',
    url: 'https://www.donanimklinik.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.donanimklinik.com/logo.png',
      width: 120,
      height: 34,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  ...(schemaType === 'Article' && {
    articleSection: tag.label,
    isBasedOn: { '@type': 'WebPage', url: officialSourceUrl },
  }),
  ...(schemaType === 'HowTo' && howtoSteps && {
    step: howtoSteps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.donanimklinik.com/' },
    { '@type': 'ListItem', position: 2, name: tag.label, item: `https://www.donanimklinik.com/${category}/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};

const dateStr = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(pubDate);

const sourceUrl = new URL(officialSourceUrl);
const sourceDomain = sourceUrl.hostname.replace('www.', '');
---

<Layout
  title={`${title} | DonanimKlinik`}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  catClass={`cat-${category}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <!-- Ezoic content category — improves advertiser targeting after Ezoic switch -->
    <meta name="ezoic-category" content={category} />
  </Fragment>

  <div class="article-page-hero">
    <div class="article-page-glow" style={`background: ${tag.color};`} aria-hidden="true"></div>
    <div class="wrap">
      <!-- Breadcrumb -->
      <nav class="page-breadcrumb" style="padding-top: 28px;" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href={`/${category}/`}>{tag.label}</a>
        {pillarName && pillarSlug && (
          <>
            <span aria-hidden="true">›</span>
            <a href={`/${category}/${pillarSlug}/`}>{pillarName}</a>
          </>
        )}
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <!-- Article meta header -->
      <div class="article-meta-header">
        <span class={`art-tag ${tag.cls}`}>{tag.label}</span>
        <h1>{title}</h1>
        <div class="article-meta-row">
          <span>{dateStr}</span>
          {readTime && <span>{readTime} min read</span>}
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    {fixSummary && (
      <AnswerCard summary={fixSummary} time={fixTime} difficulty={fixDifficulty} />
    )}

    <!-- SLOT A: above article — add slotId after AdSense approval, ezoicId=101 after Ezoic switch -->
    <AdUnit position="top" />

    <!-- Article content -->
    <article class="article-body" data-copy-buttons>
      <slot />
    </article>

    <!-- SLOT B: mid-article — add slotId after AdSense approval, ezoicId=103 after Ezoic switch -->
    <AdUnit position="middle" />

    <!-- Related chips: compact inline navigation after article body -->
    {relatedArticles.length > 0 && <RelatedChips articles={relatedArticles} />}

    <!-- Related articles (full cards at bottom) -->
    {relatedArticles.length > 0 && <RelatedArticles articles={relatedArticles} />}

    <!-- SLOT C: before FAQ — add slotId after AdSense approval, ezoicId=102 after Ezoic switch -->
    <AdUnit position="bottom" />

    <!-- FAQ section -->
    {faq && faq.length > 0 && (
      <section class="faq-section">
        <h2 class="faq-title">Frequently Asked Questions</h2>
        {faq.map(item => (
          <details class="faq-item">
            <summary class="faq-q">{item.q}</summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </section>
    )}

    <!-- Feedback widget -->
    <FeedbackWidget
      relatedArticles={relatedArticles}
      pillarName={pillarName}
      pillarSlug={pillarSlug}
      category={category}
    />

    <!-- Source citation -->
    <aside class="source-section">
      <h2 class="source-section-title mono">Source</h2>
      <a class="source-card" href={officialSourceUrl} target="_blank" rel="noopener noreferrer">
        <div class="source-card-icon-zone" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="20" height="20">
            <path d="M8 4H4a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M12 2h6m0 0v6m0-6L10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="source-card-body">
          <span class="source-card-label">Official Source</span>
          <span class="source-card-domain">{sourceDomain}</span>
        </div>
        <div class="source-card-action">
          <span>View docs</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" width="11" height="11" aria-hidden="true">
            <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    </aside>

  </div>
</Layout>

{pillarName && pillarSlug && (
  <HubPill pillarName={pillarName} pillarSlug={pillarSlug} category={category} />
)}

<!-- Scroll progress bar -->
<div id="scroll-progress" aria-hidden="true"></div>

<!-- Lightbox -->
<div id="lb-overlay" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
  <button id="lb-close" aria-label="Close image">&times;</button>
  <img id="lb-img" src="" alt="">
</div>

<style>
  /* ── FAQ section ── */
  .faq-section {
    max-width: 720px;
    margin: 0 auto 2rem;
    border-top: 1px solid #1e3a22;
    padding-top: 2rem;
  }
  .faq-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #4ade80;
    margin: 0 0 1.2rem;
  }
  .faq-item {
    border: 1px solid #1e3a22;
    border-radius: 8px;
    margin-bottom: 0.6rem;
    background: #0d1e16;
    transition: border-color .15s;
  }
  .faq-item[open] { border-color: #2a5236; }
  .faq-q {
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: #D4EAD8;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    color: #00E5A0;
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a {
    padding: 0 1.1rem 1rem;
    color: #A8C4B0;
    line-height: 1.75;
    margin: 0;
    font-size: 0.92rem;
  }

  /* ── Article images ── */
  .article-body img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #1e3a22;
    margin: 2rem auto;
    cursor: zoom-in;
    transition: opacity .15s, border-color .15s;
  }
  .article-body img:hover {
    opacity: .88;
    border-color: #00E5A0;
  }

  /* ── Lightbox overlay ── */
  #lb-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: lb-in .15s ease;
  }
  #lb-overlay[hidden] { display: none; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }

  #lb-img {
    max-width: min(96vw, 1100px);
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: 10px;
    border: 1px solid #2d5a3d;
    box-shadow: 0 0 80px rgba(0,229,160,.08);
    cursor: default;
  }

  #lb-close {
    position: fixed;
    top: 1.2rem;
    right: 1.5rem;
    background: none;
    border: 1px solid #2d5a3d;
    color: #F0F4F1;
    font-size: 1.8rem;
    line-height: 1;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .15s, color .15s;
  }
  #lb-close:hover { border-color: #00E5A0; color: #00E5A0; }

  /* ── Scroll progress bar ── */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: #00E5A0;
    z-index: 9998;
    opacity: 0;
    transition: width .12s linear, opacity .2s;
    pointer-events: none;
  }

  /* ── Copy button ── */
  :global(.copy-btn) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    padding: 0.28rem 0.6rem;
    background: #0d2e1a;
    border: 1px solid #2a5236;
    border-radius: 5px;
    color: #A8C4B0;
    font-size: 0.7rem;
    font-weight: 600;
    font-family: inherit;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity .15s, border-color .15s, color .15s;
    user-select: none;
  }
  :global(.article-body pre:hover .copy-btn) { opacity: 1; }
  :global(.copy-btn.copied) { color: #00E5A0; border-color: #00E5A0; opacity: 1; }
  @media (hover: none) { :global(.copy-btn) { opacity: 1; } }
</style>

<script>
  const overlay = document.getElementById('lb-overlay') as HTMLElement;
  const lbImg   = document.getElementById('lb-img')     as HTMLImageElement;
  const lbClose = document.getElementById('lb-close')   as HTMLButtonElement;

  function openLightbox(src: string, alt: string) {
    lbImg.src = src;
    lbImg.alt = alt;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }
  function closeLightbox() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    lbImg.src = '';
  }

  // Click any article image
  document.querySelectorAll('.article-body img').forEach(img => {
    const el = img as HTMLImageElement;
    el.setAttribute('title', 'Click to enlarge');
    el.addEventListener('click', () => openLightbox(el.src, el.alt));
  });

  lbClose.addEventListener('click', closeLightbox);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeLightbox(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>

<script>
  // Copy button for code blocks
  document.querySelectorAll('article[data-copy-buttons] pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.type = 'button';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code');
    pre.appendChild(btn);

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      const text = (code ?? pre).innerText;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 1500);
      } catch {
        // clipboard unavailable (HTTP or denied)
      }
    });
  });
</script>

<script>
  // Scroll progress bar — starts at 25% scroll, caps visual fill at 90%
  const bar = document.getElementById('scroll-progress') as HTMLElement | null;
  if (bar) {
    function updateBar() {
      const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight);
      if (scrolled < 0.25) {
        bar.style.opacity = '0';
        bar.style.width = '0%';
      } else {
        const visual = Math.min((scrolled - 0.25) / 0.75 * 90, 90);
        bar.style.opacity = '1';
        bar.style.width = visual + '%';
      }
    }
    window.addEventListener('scroll', updateBar, { passive: true });
    updateBar();
  }
</script>
